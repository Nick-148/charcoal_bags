{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "worker-configuration.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", ".wrangler"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["@astrojs/cloudflare/types.d.ts"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
