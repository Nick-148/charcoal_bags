---
/** Wordmark + mark. The text comes from site config so a rebrand needs no SVG edits. */
import { site } from '@/config/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg viewBox="0 0 40 40" class="h-9 w-9 shrink-0" aria-hidden="true">
    <rect
      x="1"
      y="1"
      width="38"
      height="38"
      rx="3"
      fill="#1d1d1d"
      stroke="currentColor"
      stroke-width="1.5"
    ></rect>
    <rect
      x="5.5"
      y="5.5"
      width="29"
      height="29"
      rx="2"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-dasharray="3 2.5"
      class="text-accent"
    ></rect>
    <circle
      cx="20"
      cy="20"
      r="6.5"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class="text-accent"
    ></circle>
    <circle cx="20" cy="20" r="1.6" fill="currentColor" class="text-accent"></circle>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="heading-display text-xl tracking-[0.08em] text-fg">{site.name.replace(/\.$/, '')}</span>
    <span class="eyebrow mt-0.5 text-[9px] text-fg-subtle">{site.tagline}</span>
  </span>
</span>
