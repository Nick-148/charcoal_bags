import { site } from '@/config/site';
import LegalLayout from '@/layouts/LegalLayout.astro';
---

<LegalLayout title="Privacy policy" updated="November 4, 2026">
  <p>
    This policy explains what {site.legalName} (“we”) collects when you use this website and how we use it. We
    collect as little as we can to run the store.
  </p>
  <h2>What we collect</h2>
  <ul>
    <li>
      <strong>Orders:</strong> your name, email, shipping address, and the items you bought. Card details are
      entered on Stripe’s checkout page and never reach our servers.
    </li>
    <li>
      <strong>Messages:</strong> what you send through the contact or bulk quote forms (name, email,
      organization, and your message).
    </li>
    <li>
      <strong>Your cart:</strong> stored in your own browser (localStorage) until you check out. We cannot see
      it.
    </li>
    <li>
      <strong>Security signals:</strong> Cloudflare processes your IP address to block bots and abuse
      (Cloudflare Turnstile and rate limiting).
    </li>
  </ul>
  <p>We do not use advertising cookies or sell, rent, or trade your personal information.</p>
  <h2>How we use it</h2>
  <ul>
    <li>To fulfill and ship your order, send receipts and tracking, and handle returns or refunds.</li>
    <li>To answer your messages and quote bulk orders.</li>
    <li>To keep the site secure and comply with legal and tax obligations.</li>
  </ul>
  <h2>Who processes it for us</h2>
  <ul>
    <li>
      <strong>Stripe</strong>: payments and receipts.
    </li>
    <li>
      <strong>Cloudflare</strong>: hosting, database, bot protection, and privacy-friendly, cookieless
      analytics.
    </li>
    <li>
      <strong>Resend</strong>: transactional email delivery.
    </li>
    <li>
      <strong>Shipping carriers</strong> (e.g. USPS): your name and address, to deliver your package.
    </li>
  </ul>
  <h2>How long we keep it</h2>
  <p>
    Order records are kept as long as required for tax and accounting purposes (typically up to seven years).
    Messages are kept up to two years and then deleted unless they relate to an open order.
  </p>
  <h2>Your choices</h2>
  <p>
    You can ask us to access, correct, or delete your personal information by emailing
    <a href={`mailto:${site.contact.supportEmail}`}>{site.contact.supportEmail}</a>. We will respond{' '}
    {site.contact.responseTime}.
  </p>
  <h2>Children</h2>
  <p>This site is not directed at children under 13, and our products are not intended for ages under 14.</p>
  <h2>Changes</h2>
  <p>If we change this policy we will update the date at the top of this page.</p>
</LegalLayout>
